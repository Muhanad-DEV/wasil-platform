# Database Configuration (SQLite for local/preview, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="wasil-super-secure-production-ready-jwt-secret-key-oman-2026"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="OMR"

# Sandbox & Demo Mode (Keep true if external credentials are not set)
ENABLE_DEMO_MODE="true"

# Apple Wallet PassKit Configuration (Optional)
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_CERTIFICATE_PEM=""
APPLE_PRIVATE_KEY_PEM=""

# Google Wallet API Configuration (Optional)
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLIENT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""

# Payment Gateways (Thawani / OmanNet / Stripe)
PAYMENT_GATEWAY_PROVIDER="sandbox"
PAYMENT_API_KEY=""
